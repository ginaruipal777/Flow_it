{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/micro_paso.py": { "maxDuration": 40 }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
